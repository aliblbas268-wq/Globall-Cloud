<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ئەدمین — Global Cloud Logistics</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#08111f;--deep:#0c1a30;--card:#0f2040;--card2:#132545;
  --gold:#c9a84c;--gold2:#e8c96a;
  --sky:#1e90d4;--sky2:#4fb3f0;
  --green:#22c55e;--red:#ef4444;--orange:#f59e0b;
  --white:#f0f4ff;--gray:#7a93b8;--border:rgba(201,168,76,.18);
  --radius:14px;--shadow:0 8px 32px rgba(0,0,0,.4);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Tajawal',sans-serif;background:var(--navy);color:var(--white);min-height:100vh}

/* ─── AUTH ─── */
#admin-login{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:100vh;padding:40px 20px;
  background:radial-gradient(ellipse 80% 60% at 50% 30%,rgba(30,144,212,.1),transparent),var(--navy);
}
.admin-login-box{
  background:rgba(255,255,255,.04);border:1px solid var(--border);
  border-radius:20px;padding:36px 28px;width:100%;max-width:400px;
}
.admin-badge{
  text-align:center;margin-bottom:28px;
}
.admin-badge .icon{
  width:70px;height:70px;background:linear-gradient(135deg,var(--gold),var(--sky));
  border-radius:18px;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;font-size:36px;
  box-shadow:0 0 30px rgba(201,168,76,.3);
}
.admin-badge h2{font-size:22px;font-weight:900}
.admin-badge p{color:var(--gray);font-size:13px}
.field{margin-bottom:16px}
.field label{display:block;font-size:13px;color:var(--gray);margin-bottom:7px;font-weight:600}
.field input{
  width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  border-radius:10px;padding:13px 16px;color:var(--white);
  font-family:'Tajawal',sans-serif;font-size:15px;outline:none;transition:.3s;
}
.field input:focus{border-color:var(--gold)}
.field input::placeholder{color:var(--gray)}
.err{color:var(--red);font-size:13px;margin-bottom:10px;display:none}
.err.show{display:block}
.btn{width:100%;padding:14px;border:none;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:16px;font-weight:700;cursor:pointer;transition:.3s}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold2));color:#08111f;box-shadow:0 4px 20px rgba(201,168,76,.3)}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(201,168,76,.5)}
.btn-sky{background:linear-gradient(135deg,var(--sky),var(--sky2));color:#fff}
.btn-sky:hover{transform:translateY(-2px)}
.btn-sm{padding:8px 18px;font-size:13px;font-weight:700;border:none;border-radius:8px;font-family:'Tajawal',sans-serif;cursor:pointer;transition:.3s}
.btn-green{background:rgba(34,197,94,.15);color:var(--green);border:1px solid rgba(34,197,94,.3)}
.btn-green:hover{background:rgba(34,197,94,.25)}
.btn-red{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.3)}
.btn-red:hover{background:rgba(239,68,68,.25)}
.btn-orange{background:rgba(245,158,11,.15);color:var(--orange);border:1px solid rgba(245,158,11,.3)}

/* ─── ADMIN APP ─── */
#admin-app{display:none;flex-direction:column;min-height:100vh}
.admin-header{
  background:rgba(8,17,31,.97);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
  padding:14px 24px;display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;z-index:100;
}
.admin-logo{display:flex;align-items:center;gap:10px}
.admin-logo .icon{width:38px;height:38px;background:linear-gradient(135deg,var(--gold),var(--sky));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px}
.admin-logo span{font-weight:900;font-size:17px}
.admin-logo small{display:block;color:var(--gold);font-size:11px;letter-spacing:.1em}
.admin-header-right{display:flex;gap:10px;align-items:center}
.admin-nav{
  background:rgba(12,26,48,.9);border-bottom:1px solid var(--border);
  padding:0 24px;display:flex;gap:4px;overflow-x:auto;
}
.admin-nav::-webkit-scrollbar{display:none}
.anav-btn{
  padding:14px 18px;border:none;background:transparent;
  color:var(--gray);font-family:'Tajawal',sans-serif;font-size:14px;font-weight:700;
  cursor:pointer;border-bottom:2px solid transparent;transition:.3s;white-space:nowrap;
}
.anav-btn.active{color:var(--gold2);border-bottom-color:var(--gold)}
.anav-btn:hover{color:var(--white)}
.admin-content{padding:24px;flex:1}
.apage{display:none}
.apage.active{display:block;animation:fadeIn .2s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

/* ─── STATS CARDS ─── */
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;margin-bottom:24px}
.stat-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px;text-align:center;
}
.stat-card .sc-num{font-size:38px;font-weight:900;line-height:1}
.stat-card .sc-label{color:var(--gray);font-size:12px;margin-top:6px;font-weight:600}
.stat-gold .sc-num{color:var(--gold2)}
.stat-sky .sc-num{color:var(--sky2)}
.stat-green .sc-num{color:var(--green)}
.stat-orange .sc-num{color:var(--orange)}
.stat-red .sc-num{color:#f87171}

/* ─── TABLE ─── */
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
thead th{
  background:rgba(255,255,255,.04);
  padding:12px 14px;text-align:right;
  color:var(--gray);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  border-bottom:1px solid var(--border);white-space:nowrap;
}
tbody tr{border-bottom:1px solid rgba(255,255,255,.05);transition:.2s}
tbody tr:hover{background:rgba(255,255,255,.03)}
tbody td{padding:13px 14px;white-space:nowrap}
.badge{display:inline-block;padding:4px 10px;border-radius:100px;font-size:11px;font-weight:700}
.badge-sky{background:rgba(30,144,212,.15);color:var(--sky2)}
.badge-ok{background:rgba(34,197,94,.15);color:#4ade80}
.badge-warn{background:rgba(245,158,11,.15);color:var(--orange)}
.badge-err{background:rgba(239,68,68,.15);color:#f87171}
.actions{display:flex;gap:6px}

/* ─── SECTION HEADER ─── */
.sec-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.sec-header h2{font-size:18px;font-weight:900}
.search-bar{
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  border-radius:10px;padding:10px 14px;color:var(--white);
  font-family:'Tajawal',sans-serif;font-size:14px;outline:none;
  width:220px;transition:.3s;
}
.search-bar:focus{border-color:var(--sky);width:260px}
.search-bar::placeholder{color:var(--gray)}

/* ─── MODAL ─── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(6px);z-index:200;align-items:center;justify-content:center;padding:20px}
.modal-overlay.show{display:flex}
.modal{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:28px;width:100%;max-width:540px;max-height:88vh;overflow-y:auto;animation:zoomIn .25s ease}
@keyframes zoomIn{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
.modal-title{font-size:18px;font-weight:900;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center}
.modal-close{background:none;border:none;color:var(--gray);font-size:22px;cursor:pointer}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px}
select{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:13px 14px;color:var(--white);font-family:'Tajawal',sans-serif;font-size:14px;outline:none;width:100%;transition:.3s}
select:focus{border-color:var(--gold)}
select option{background:var(--card)}
textarea{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:13px 14px;color:var(--white);font-family:'Tajawal',sans-serif;font-size:14px;outline:none;width:100%;resize:vertical;min-height:90px}
textarea:focus{border-color:var(--gold)}

/* ─── TOAST ─── */
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-20px);background:#1a3050;border:1px solid var(--sky);border-radius:10px;padding:12px 28px;font-size:14px;font-weight:700;z-index:500;opacity:0;transition:.4s;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ─── INFO BOX ─── */
.info-box{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:12px;font-size:13px;line-height:1.9}
.info-box b{color:var(--white)}
.info-box span{color:var(--gray)}

/* ─── ACTIVITY ─── */
.activity-item{display:flex;gap:12px;padding:12px;background:rgba(255,255,255,.03);border-radius:10px;margin-bottom:8px;border:1px solid var(--border)}
.ac-icon{font-size:22px;min-width:36px}
.ac-body p{font-size:13px;font-weight:600}
.ac-body span{font-size:12px;color:var(--gray)}

@media(max-width:600px){
  .admin-content{padding:16px}
  .stats-row{grid-template-columns:1fr 1fr}
  table{font-size:12px}
  thead th,tbody td{padding:10px 8px}
  .two-col{grid-template-columns:1fr}
  .search-bar{width:140px}
  .search-bar:focus{width:160px}
}
</style>
</head>
