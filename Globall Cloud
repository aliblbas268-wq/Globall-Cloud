<script>
// ── ADMIN LOGIN ──────────────────────────────────────
function adminLogin() {
  const id = document.getElementById('a-id').value.trim();
  const pw = document.getElementById('a-pass').value;
  const err = document.getElementById('a-err');
  const r = GC.login(id, pw);
  if (!r.ok) { err.textContent = r.msg; err.classList.add('show'); return; }
  if (r.user.role !== 'admin') { err.textContent = 'تەنها ئەدمین دەتوانێت بچێتە ژوورەوە'; err.classList.add('show'); GC.logout(); return; }
  initAdminApp(r.user);
}

function initAdminApp(u) {
  document.getElementById('admin-login').style.display = 'none';
  document.getElementById('admin-app').style.display = 'flex';
  document.getElementById('admin-name').textContent = u.name;
  renderDashboard();
  renderShipments();
  renderUsers();
  setTodayDates();
}

// ── AUTO LOGIN ────────────────────────────────────────
document.addEventListener('DOMContentLoaded', ()=>{
  const u = GC.currentUser();
  if (u && u.role === 'admin') initAdminApp(u);
});

// ── NAV ──────────────────────────────────────────────
function switchAdmin(tab) {
  document.querySelectorAll('.apage').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.anav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('apage-'+tab).classList.add('active');
  document.getElementById('anav-'+tab).classList.add('active');
}

// ── DASHBOARD ────────────────────────────────────────
function renderDashboard() {
  const s = GC.getShipments();
  const u = GC.getUsers().filter(x=>x.role==='customer');
  const totalRev   = s.reduce((a,b)=>a+(b.totalAmount||0),0);
  const totalDue   = s.reduce((a,b)=>a+(b.dueAmount||0),0);
  const inTransit  = s.filter(x=>x.status==='in_transit').length;
  const delivered  = s.filter(x=>x.status==='delivered').length;
  const pending    = s.filter(x=>x.status==='pending').length;

  document.getElementById('dash-stats').innerHTML = `
    <div class="stat-card stat-gold"><div class="sc-num">${s.length}</div><div class="sc-label">کۆی بارگواستن</div></div>
    <div class="stat-card stat-sky"><div class="sc-num">${inTransit}</div><div class="sc-label">لە ڕێگەیە</div></div>
    <div class="stat-card stat-green"><div class="sc-num">${delivered}</div><div class="sc-label">گەیشتووە</div></div>
    <div class="stat-card stat-orange"><div class="sc-num">${pending}</div><div class="sc-label">چاوەڕوانکراو</div></div>
    <div class="stat-card stat-sky"><div class="sc-num">${u.length}</div><div class="sc-label">کڕیار</div></div>
    <div class="stat-card stat-gold"><div class="sc-num">$${(totalRev/1000).toFixed(1)}K</div><div class="sc-label">کۆی داهات</div></div>
    <div class="stat-card stat-red"><div class="sc-num">$${(totalDue/1000).toFixed(1)}K</div><div class="sc-label">کۆی ماوە</div></div>
  `;

  document.getElementById('dash-activity').innerHTML = s.slice(0,5).map(x=>`
    <div class="activity-item">
      <div class="ac-icon">${GC.typeIcon(x.type)}</div>
      <div class="ac-body">
        <p><b>${x.id}</b> — ${x.customerName||'—'} — ${x.from} → ${x.to}</p>
        <span>${x.orderDate} · <span class="badge ${GC.statusClass(x.status)}">${GC.statusLabel(x.status)}</span></span>
      </div>
    </div>
  `).join('');
}

// ── SHIPMENTS ─────────────────────────────────────────
function renderShipments(filter='') {
  let s = GC.getShipments();
  if (filter) s = s.filter(x=>
    x.id.toLowerCase().includes(filter) ||
    (x.customerName||'').toLowerCase().includes(filter) ||
    (x.customerPhone||'').includes(filter)
  );
  document.getElementById('shipments-tbody').innerHTML = s.map(x=>`
    <tr>
      <td><b>${x.id}</b></td>
      <td>
        <div style="font-weight:600">${x.customerName||'—'}</div>
        <div style="color:var(--gray);font-size:11px">${x.customerPhone||''}</div>
      </td>
      <td>${GC.typeLabel(x.type)}</td>
      <td style="font-size:12px">${x.from}<br><span style="color:var(--sky2)">→ ${x.to}</span></td>
      <td>${x.weight} کگ</td>
      <td style="color:var(--gold2);font-weight:700">${GC.formatMoney(x.totalAmount)}</td>
      <td style="color:${x.dueAmount>0?'var(--red)':'var(--green)'};font-weight:700">${GC.formatMoney(x.dueAmount)}</td>
      <td><span class="badge ${GC.statusClass(x.status)}">${GC.statusLabel(x.status)}</span></td>
      <td>
        <div class="actions">
          <button class="btn-sm btn-green" onclick="viewShipment('${x.id}')">👁</button>
          <button class="btn-sm btn-orange" onclick="editShipment('${x.id}')">✏️</button>
          <button class="btn-sm btn-red" onclick="deleteShipmentAdmin('${x.id}')">🗑</button>
        </div>
      </td>
    </tr>
  `).join('') || `<tr><td colspan="9" style="text-align:center;padding:30px;color:var(--gray)">هیچ بارگواستنێک نەدۆزرایەوە</td></tr>`;
}

function filterShipments() {
  renderShipments(document.getElementById('ship-search').value.trim().toLowerCase());
}

function deleteShipmentAdmin(id) {
  if (!confirm('دڵنیایت لە سڕینەوەی ' + id + '؟')) return;
  GC.deleteShipment(id);
  renderShipments(); renderDashboard();
  showToast('🗑 بارگواستن سڕایەوە');
}

// ── VIEW SHIPMENT ─────────────────────────────────────
function viewShipment(id) {
  const s = GC.getShipmentById(id);
  if (!s) return;
  document.getElementById('view-content').innerHTML = `
    <div class="info-box">
      <div><span>کۆد:</span> <b>${s.id}</b> &nbsp;&nbsp; <span class="badge ${GC.statusClass(s.status)}">${GC.statusLabel(s.status)}</span></div>
      <div><span>کڕیار:</span> <b>${s.customerName||'—'}</b> · ${s.customerPhone||''}</div>
      <div><span>ڕێگا:</span> <b>${GC.typeLabel(s.type)}</b></div>
      <div><span>لە → بۆ:</span> <b>${s.from} → ${s.to}</b></div>
      <div><span>کێش:</span> <b>${s.weight} کگ</b> · قەبارە: <b>${s.volume} CBM</b></div>
      <div><span>تاریخ:</span> <b>${s.orderDate}</b> · گەیاندن: <b>${s.estimatedDelivery||'—'}</b></div>
      <div><span>کۆی نرخ:</span> <b style="color:var(--gold2)">${GC.formatMoney(s.totalAmount)}</b></div>
      <div><span>مافی:</span> <b style="color:var(--green)">${GC.formatMoney(s.paidAmount)}</b> · ماوە: <b style="color:var(--red)">${GC.formatMoney(s.dueAmount)}</b></div>
      <div><span>پارەدان:</span> <b>${s.paymentMethod}</b></div>
      ${s.notes ? `<div><span>تێبینی:</span> <b>${s.notes}</b></div>` : ''}
    </div>
    <div style="margin-top:12px"><b>⏱ ژمارەی کاتی</b></div>
    ${s.timeline.map(t=>`
      <div style="display:flex;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
        <span style="font-size:18px">${t.done?'✅':'⭕'}</span>
        <div>
          <div style="font-size:13px;font-weight:700">${t.event}</div>
          <div style="font-size:11px;color:var(--gray)">${t.date||'چاوەڕوانکراوە'}</div>
        </div>
      </div>
    `).join('')}
    <div style="margin-top:16px">
      <a href="https://wa.me/9647507577137?text=سڵاو، دەربارەی بارگواستنی ${s.id}" target="_blank" class="btn btn-green" style="display:block;text-align:center;text-decoration:none;padding:12px;border-radius:10px;background:rgba(34,197,94,.15);color:var(--green);border:1px solid rgba(34,197,94,.3);font-weight:700">💬 پەیوەندی بە کڕیار</a>
    </div>
  `;
  openModal('modal-view');
}

// ── EDIT SHIPMENT ─────────────────────────────────────
function editShipment(id) {
  const s = GC.getShipmentById(id);
  if (!s) return;
  document.getElementById('edit-content').innerHTML = `
    <div class="field"><label>حاڵەت</label>
      <select id="e-status">
        ${['pending','in_transit','delivered','cancelled'].map(v=>`<option value="${v}" ${v===s.status?'selected':''}>${GC.statusLabel(v)}</option>`).join('')}
      </select>
    </div>
    <div class="two-col">
      <div class="field"><label>کۆی نرخ ($)</label><input id="e-total" type="number" value="${s.totalAmount}"></div>
      <div class="field"><label>مافی ($)</label><input id="e-paid" type="number" value="${s.paidAmount}"></div>
    </div>
    <div class="field"><label>ڕێگای پارەدان</label>
      <select id="e-payment">
        ${['Cash','Bank Transfer','Pending'].map(v=>`<option ${v===s.paymentMethod?'selected':''}>${v}</option>`).join('')}
      </select>
    </div>
    <div class="field"><label>تاریخی گەیاندن</label><input id="e-delivery" type="date" value="${s.estimatedDelivery||''}"></div>
    <div class="field"><label>تێبینی</label><textarea id="e-notes">${s.notes||''}</textarea></div>
    <div style="margin-top:4px"><b>⏱ نوێکردنەوەی ژمارەی کاتی</b></div>
    ${s.timeline.map((t,i)=>`
      <div style="display:flex;gap:10px;align-items:center;padding:8px;background:rgba(255,255,255,.03);border-radius:8px;margin-top:6px">
        <input type="checkbox" id="tl-${i}" ${t.done?'checked':''} style="width:18px;height:18px;cursor:pointer">
        <div style="flex:1">
          <div style="font-size:13px;font-weight:600">${t.event}</div>
          <input type="date" id="tl-date-${i}" value="${t.date||''}" style="margin-top:4px;background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:6px;padding:5px 10px;color:var(--white);font-family:'Tajawal',sans-serif;font-size:12px;outline:none">
        </div>
      </div>
    `).join('')}
    <button class="btn btn-gold" style="margin-top:16px" onclick="saveEdit('${id}')">💾 پاشەکەوتکردن</button>
  `;
  openModal('modal-edit');
}

function saveEdit(id) {
  const s = GC.getShipmentById(id);
  const total = +document.getElementById('e-total').value;
  const paid  = +document.getElementById('e-paid').value;
  const newTimeline = s.timeline.map((t,i)=>({
    ...t,
    done: document.getElementById(`tl-${i}`)?.checked || false,
    date: document.getElementById(`tl-date-${i}`)?.value || ''
  }));
  GC.updateShipment(id, {
    status:  document.getElementById('e-status').value,
    totalAmount: total,
    paidAmount: paid,
    dueAmount: Math.max(0, total - paid),
    paymentMethod: document.getElementById('e-payment').value,
    estimatedDelivery: document.getElementById('e-delivery').value,
    notes: document.getElementById('e-notes').value,
    timeline: newTimeline
  });
  closeModal('modal-edit');
  renderShipments(); renderDashboard();
  showToast('✅ بارگواستن نوێکرایەوە');
}

// ── USERS ─────────────────────────────────────────────
function renderUsers(filter='') {
  let u = GC.getUsers().filter(x=>x.role==='customer');
  if (filter) u = u.filter(x=>
    x.name.toLowerCase().includes(filter) ||
    (x.phone||'').includes(filter) ||
    (x.email||'').toLowerCase().includes(filter)
  );
  document.getElementById('users-tbody').innerHTML = u.map(x=>`
    <tr>
      <td><b>${x.name}</b></td>
      <td>${x.phone||'—'}</td>
      <td style="color:var(--gray)">${x.email||'—'}</td>
      <td><span class="badge badge-sky">کڕیار</span></td>
      <td style="color:var(--gray)">${x.createdAt||'—'}</td>
      <td>
        <div class="actions">
          <a href="https://wa.me/${(x.phone||'').replace(/\D/g,'')}" target="_blank" class="btn-sm btn-green" style="text-decoration:none">💬</a>
          <button class="btn-sm btn-red" onclick="deleteUserAdmin('${x.id}','${x.name}')">🗑</button>
        </div>
      </td>
    </tr>
  `).join('') || `<tr><td colspan="6" style="text-align:center;padding:30px;color:var(--gray)">هیچ کڕیارێک نەدۆزرایەوە</td></tr>`;
}

function filterUsers() {
  renderUsers(document.getElementById('user-search').value.trim().toLowerCase());
}

function deleteUserAdmin(id, name) {
  if (!confirm('دڵنیایت لە سڕینەوەی ' + name + '؟')) return;
  GC.deleteUser(id);
  renderUsers(); renderDashboard();
  showToast('🗑 کڕیار سڕایەوە');
}

// ── NEW SHIPMENT ──────────────────────────────────────
function setTodayDates() {
  const t = new Date().toISOString().split('T')[0];
  document.getElementById('ns-date').value = t;
}

function adminCreateShipment() {
  const total = +document.getElementById('ns-total').value || 0;
  const paid  = +document.getElementById('ns-paid').value || 0;
  const s = GC.createShipment({
    customerName:  document.getElementById('ns-cname').value,
    customerPhone: document.getElementById('ns-cphone').value,
    from:     document.getElementById('ns-from').value,
    to:       document.getElementById('ns-to').value,
    type:     document.getElementById('ns-type').value,
    weight:   document.getElementById('ns-weight').value || '0',
    volume:   document.getElementById('ns-volume').value || '0',
    totalAmount: total,
    paidAmount: paid,
    dueAmount: Math.max(0, total - paid),
    paymentMethod: document.getElementById('ns-payment').value,
    orderDate: document.getElementById('ns-date').value,
    estimatedDelivery: document.getElementById('ns-delivery').value,
    notes: document.getElementById('ns-notes').value,
    userId: null
  });
  // override status
  GC.updateShipment(s.id, { status: document.getElementById('ns-status').value });
  showToast('✅ بارگواستنی نوێ دروستکرا: ' + s.id);
  renderShipments(); renderDashboard();
  switchAdmin('shipments');
}

// ── UTILS ─────────────────────────────────────────────
function openModal(id)  { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
document.querySelectorAll('.modal-overlay').forEach(m=>{
  m.addEventListener('click',e=>{ if(e.target===m) m.classList.remove('show'); });
});
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 3000);
}
</script>
</body>
</html>
